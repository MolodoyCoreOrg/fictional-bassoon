BOT_TOKEN="replace-with-bot-token"
ADMINS=""
ENV="PROD"

COOKIES_FILE="/app/cookies.txt"
COOKIES_FROM_BROWSER=""
YOUTUBE_PLAYER_CLIENT=""
YOUTUBE_PO_TOKEN=""
YOUTUBE_VISITOR_DATA=""
# URL sidecar-сервиса bgutil для динамических YouTube PO-токенов.
YOUTUBE_POT_PROVIDER_URL=""
# Источники inline-поиска. Яндекс/Deezer/iTunes работают как публичные
# каталоги; для vksearch нужен VK_ACCESS_TOKEN.
AUDIO_SEARCH_SOURCES="scsearch,yandexsearch,vksearch,deezersearch,itunessearch,ytsearch"
# Страна каталога Apple/iTunes (двухбуквенный код).
ITUNES_COUNTRY="RU"
# Сколько результатов каждого источника пробовать при резервном поиске (1-10).
AUDIO_FALLBACK_CANDIDATES="3"
# Минимальное сходство названия/исполнителя (0.50-1.00); ниже трек не отправляется.
AUDIO_FALLBACK_MIN_MATCH="0.78"
# Максимум треков в одном SoundCloud Set-задании (1-200); Telegram-группы идут по 10.
AUDIO_COLLECTION_MAX_TRACKS="100"
VK_ACCESS_TOKEN=""
VK_API_VERSION="5.199"
# curl_cffi имитирует TLS/browser fingerprint для площадок с Cloudflare.
YTDLP_IMPERSONATE="chrome"
YTDLP_FORCE_IPV4="true"
YTDLP_JS_RUNTIME="node"

# Публичный HTTPS URL этого приложения без завершающего слеша.
# Reverse proxy должен направлять /inline/audio/* на INLINE_MEDIA_PORT.
INLINE_MEDIA_BASE_URL=""
INLINE_MEDIA_HOST="0.0.0.0"
INLINE_MEDIA_PORT="8080"
INLINE_MEDIA_CACHE_DIR="/app/temp/inline_media_cache"
TRACK_HISTORY_DB="/app/data/track_history.sqlite3"
# Необязательно: закрытый канал/чат, куда бот складывает Telegram file_id.
INLINE_STORAGE_CHAT_ID=""

# Пусто = api.telegram.org и лимит 50 МБ.
TELEGRAM_API_BASE_URL=""
# true только при общей файловой системе у бота и Bot API Server.
TELEGRAM_LOCAL_FILE_MODE="false"
# Пусто = автоматически 50 для cloud или 2000 для local.
TELEGRAM_MAX_UPLOAD_MB=""
# Максимальное ожидание одной отправки большого видео: 7200 с для local, 300 с для cloud.
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=""
